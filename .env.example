# Server-only: add in Vercel Environment Variables or an ignored .env.local.
# Hosted checkout needs only the secret key; no public key is required.
PAYSTACK_SECRET_KEY=
# Enable USD only if your Paystack account supports USD collections.
PAYSTACK_USD_ENABLED=false
BOOKING_URL=https://calendar.app.google/4Z1x1rKG1f6mJqTu9
# Canonical production origin, without a trailing path.
SITE_URL=
