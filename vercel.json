{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    {"source":"/","destination":"/work","permanent":false},
    {"source":"/design","destination":"/work","permanent":false}
  ],
  "rewrites": [{"source":"/gtag/js","destination":"/gtag-stub.js"}],
  "headers": [
    {"source":"/(.*)","headers":[{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"}]},
    {"source":"/(.*).rsc","headers":[{"key":"Content-Type","value":"text/x-component; charset=utf-8"},{"key":"Cache-Control","value":"no-store"}]},
    {"source":"/works.json","headers":[{"key":"Cache-Control","value":"no-store"}]},
    {"source":"/api/(.*)","headers":[{"key":"Cache-Control","value":"no-store"}]},
    {"source":"/checkout","headers":[{"key":"X-Frame-Options","value":"DENY"},{"key":"Referrer-Policy","value":"no-referrer"}]}
  ]
}
